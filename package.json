{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Search, Organize, Summarize — a private local-AI file workspace",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "tsc --noEmit && vite build",
    "check:bundle": "node scripts/assert-production-excludes-fake.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 1421 --strictPort",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tauri-apps/api": "^2.8.0",
    "d3-force": "^3.0.0",
    "lucide-react": "^1.54.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tauri-apps/cli": "^2.8.4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "4.14.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
